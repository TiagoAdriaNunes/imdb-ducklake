# Optional overrides. Defaults resolve relative to the repository root.
IMDB_LAKEHOUSE_DATA_DIR=data
IMDB_LAKEHOUSE_LOG_LEVEL=DEBUG
IMDB_DUCKLAKE_DBT_THREADS=2
IMDB_DUCKLAKE_QUERY_THREADS=2
IMDB_DUCKLAKE_INGEST_WORKERS=2
IMDB_DUCKLAKE_DUCKDB_MEMORY_LIMIT=6GB
# DuckDB read-ahead for dbt: 0 = off (default; avoids spilling at low memory per thread),
# -1 = DuckDB's unlimited default.
IMDB_DUCKLAKE_READ_AHEAD_DEPTH=0
IMDB_DUCKLAKE_APP_PORT=8000

# Deployment profile - one of local, docker, docker-cloud. Compose uses this for the app;
# its lakehouse pipeline always uses docker so builds write to local ./data storage.
# For host CLI commands, setting IMDB_DUCKLAKE_CATALOG_URL under 'local' is a configuration
# error (it usually means a stale value leaked in from another profile).
# IMDB_DUCKLAKE_REMOTE_STORAGE is only read under docker-cloud.
#   local        - no shared catalog: reads/writes data/ducklake/current directly. No Docker.
#   docker       - shared PostgreSQL catalog (compose's `postgres` service), storage still local
#                  (current/storage on the ./data volume mount) - never touches Hugging Face.
#   docker-cloud - shared PostgreSQL catalog, storage on hf or b2 (IMDB_DUCKLAKE_REMOTE_STORAGE).
IMDB_DUCKLAKE_ENV=local

POSTGRES_DB=ducklake_catalog
POSTGRES_USER=imdb
POSTGRES_PASSWORD=imdb-local-dev
POSTGRES_PORT=5432
# Only consulted when IMDB_DUCKLAKE_ENV is docker or docker-cloud. Compose always sets this
# explicitly for its own containers (host `postgres`, not `localhost`); leave unset to run CLI
# commands from the host against `make docker-up`'s Postgres via the default below.
IMDB_DUCKLAKE_CATALOG_URL=postgresql://imdb:imdb-local-dev@postgres:5432/ducklake_catalog
# Remote storage for the app. Both can stay configured; the selector picks which one it reads.
# Required when IMDB_DUCKLAKE_ENV=docker-cloud, ignored otherwise (ADR 0013, 0016, 0017).
#   hf - HF_DATASET_REPO below (HF_TOKEN if private)
#   b2 - B2_BUCKET at BLAZE_ENDPOINT, with the BLAZE_* key
IMDB_DUCKLAKE_REMOTE_STORAGE=hf
# Hugging Face Dataset repo, not a Bucket (ADR 0013). `make upload-dataset` publishes to it.
HF_DATASET_REPO=<you>/<name>
# Required if HF_DATASET_REPO is private - a fine-grained read-only token is enough for the app;
# https://huggingface.co/settings/tokens
HF_TOKEN=
# Backblaze B2 bucket. `make upload-b2` publishes to it. BLAZE_ENDPOINT is the bucket's
# "Endpoint" in the B2 web UI. Use an application key (B2's S3 API rejects the master key);
# compose passes it to the app as AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
B2_BUCKET=imdb-ducklake
BLAZE_ENDPOINT=s3.<region>.backblazeb2.com
BLAZE_KEY_ID=
BLAZE_TOKEN=
# The app copies its tables (~165 MB) into memory at startup, so every query is local after a
# one-time load (ADR 0016). Set false to query storage directly and save ~1 GB of RAM.
IMDB_DUCKLAKE_APP_PRELOAD=true
