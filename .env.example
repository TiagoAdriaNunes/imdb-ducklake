# Optional overrides. Defaults resolve relative to the repository root.
IMDB_LAKEHOUSE_DATA_DIR=data
IMDB_LAKEHOUSE_LOG_LEVEL=DEBUG
IMDB_DUCKLAKE_DBT_THREADS=1
IMDB_DUCKLAKE_QUERY_THREADS=2
IMDB_DUCKLAKE_DUCKDB_MEMORY_LIMIT=6GB
IMDB_DUCKLAKE_APP_PORT=8000
POSTGRES_DB=ducklake_catalog
POSTGRES_USER=imdb
POSTGRES_PASSWORD=imdb-local-dev
POSTGRES_PORT=5432
IMDB_DUCKLAKE_CATALOG_URL=postgresql://imdb:imdb-local-dev@postgres:5432/ducklake_catalog
