# Optional overrides. Defaults resolve relative to the repository root.
IMDB_LAKEHOUSE_DATA_DIR=data
IMDB_LAKEHOUSE_LOG_LEVEL=DEBUG
IMDB_DUCKLAKE_DBT_THREADS=2
IMDB_DUCKLAKE_QUERY_THREADS=2
IMDB_DUCKLAKE_INGEST_WORKERS=2
IMDB_DUCKLAKE_INGEST_CHUNK_SIZE=50000
IMDB_DUCKLAKE_DUCKDB_MEMORY_LIMIT=6GB
IMDB_DUCKLAKE_APP_PORT=8000

# Deployment profile - one of local, docker, docker-cloud. This is the single source of truth
# for which catalog/storage the CLI and app use; setting IMDB_DUCKLAKE_CATALOG_URL or
# IMDB_DUCKLAKE_STORAGE_URL while IMDB_DUCKLAKE_ENV=local is a configuration error (on purpose -
# it usually means a stale value leaked in from a different profile).
#   local        - no shared catalog: reads/writes data/ducklake/current directly. No Docker.
#   docker       - shared PostgreSQL catalog (compose's `postgres` service), storage still local
#                  (current/storage on the ./data volume mount).
#   docker-cloud - shared PostgreSQL catalog + storage_url required, e.g. an HF Dataset repo.
IMDB_DUCKLAKE_ENV=local

POSTGRES_DB=ducklake_catalog
POSTGRES_USER=imdb
POSTGRES_PASSWORD=imdb-local-dev
POSTGRES_PORT=5432
# Only consulted when IMDB_DUCKLAKE_ENV is docker or docker-cloud. Compose always sets this
# explicitly for its own containers (host `postgres`, not `localhost`); leave unset to run CLI
# commands from the host against `make docker-up`'s Postgres via the default below.
IMDB_DUCKLAKE_CATALOG_URL=postgresql://imdb:imdb-local-dev@postgres:5432/ducklake_catalog
# Required only for `make upload-dataset`. Must be a Dataset repo, not a Bucket - see ADR 0013.
HF_DATASET_REPO=<you>/<name>
# Required when IMDB_DUCKLAKE_ENV=docker-cloud (optional under docker): the app reads marts from
# this HF Dataset repo instead of local current/storage (see ADR 0013).
IMDB_DUCKLAKE_STORAGE_URL=hf://datasets/<you>/<name>
# Required if IMDB_DUCKLAKE_STORAGE_URL points at a private repo - a fine-grained read-only
# token is enough for the app; https://huggingface.co/settings/tokens
HF_TOKEN=
